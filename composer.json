{
    "name": "php-domain-experiment/php-domain-experiment",
    "require": {
        "php": "^8.3",
        "ramsey/uuid": "*",
        "doctrine/migrations": "*",
        "doctrine/orm": "*",
        "doctrine/dbal": "*",
        "symfony/cache": "*",
        "php-di/php-di": "*",
        "symfony/console": "*",
        "symfony/dotenv": "*"
    },
    "require-dev": {
        "pestphp/pest": "*",
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "*",
        "mockery/mockery": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "cs-fixer": "/var/www/tabletkovbot/vendor/bin/php-cs-fixer fix",
        "console": "php src/Freelance/Presentation/Console/Console.php"
    }
}
