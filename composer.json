{
    "name": "php-domain-experiment/php-domain-experiment",
    "require": {
        "php": "^8.4",
        "ramsey/uuid": "^4.10",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.8",
        "doctrine/dbal": "^4.6",
        "symfony/cache": "^8.1",
        "php-di/php-di": "^7.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1"
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "cs-fixer": "/var/www/tabletkovbot/vendor/bin/php-cs-fixer fix"
    }
}
